<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.*?>
<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.HomePageController"
      style="-fx-background-color: #1a1a2e;" prefWidth="800" prefHeight="600">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
    <Label text="Welcome to GoNature" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
    <Label text="Discover the beauty of our parks and streamline your visit" style="-fx-text-fill: #a0a0b8; -fx-font-size: 14px;" wrapText="true" textAlignment="CENTER"/>
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER">
            <Label text="Server:" style="-fx-text-fill: #c0c0d8;"/>
            <TextField fx:id="serverHostField" text="localhost" prefWidth="150" style="-fx-background-color: #16213e; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Label text="Port:" style="-fx-text-fill: #c0c0d8;"/>
            <TextField fx:id="serverPortField" text="5555" prefWidth="70" style="-fx-background-color: #16213e; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Button fx:id="connectBtn" text="Connect" onAction="#handleConnect" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8;"/>
        </HBox>
        <Label fx:id="connectionStatus" text="" style="-fx-text-fill: #e94560;"/>
    </VBox>
    <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
        <Button fx:id="travelerLoginBtn" text="Traveler Login" onAction="#handleTravelerLogin" disable="true"
                prefWidth="200" prefHeight="40" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 10; -fx-cursor: hand;"/>
        <Button fx:id="workerLoginBtn" text="Worker Login" onAction="#handleWorkerLogin" disable="true"
                prefWidth="200" prefHeight="40" style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 10; -fx-cursor: hand;"/>
    </VBox>
    <HBox alignment="CENTER" spacing="30" style="-fx-padding: 20;">
        <Label text="Our Parks:" style="-fx-text-fill: #808098; -fx-font-size: 12px;"/>
    </HBox>
    <Button text="Exit" onAction="#handleExit" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 8;"/>
</VBox>
