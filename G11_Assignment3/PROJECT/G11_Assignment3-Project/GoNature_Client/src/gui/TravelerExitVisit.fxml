<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.TravelerExitVisitController"
            style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30; -fx-background-color: #12121f;">

    <Label text="Exit Visit" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Register your visit exit from the park" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <!-- Active visit card -->
    <VBox fx:id="visitCard" spacing="0" maxWidth="420"
          style="-fx-background-color: #1c1c2e; -fx-background-radius: 14; -fx-border-color: #34344f;
                 -fx-border-radius: 14; -fx-border-width: 1;">
        <!-- Card header -->
        <HBox style="-fx-background-color: #252538; -fx-padding: 14 20; -fx-background-radius: 14 14 0 0;">
            <Label text="Active Visit" style="-fx-text-fill: #34d399; -fx-font-size: 13px; -fx-font-weight: bold;"/>
        </HBox>
        <!-- Rows -->
        <VBox spacing="0">
            <HBox spacing="10" style="-fx-padding: 12 20;">
                <Label text="Park" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
                <Label fx:id="parkLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>
            <Separator style="-fx-opacity: 0.2;"/>
            <HBox spacing="10" style="-fx-padding: 12 20;">
                <Label text="Date" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
                <Label fx:id="dateLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px;"/>
            </HBox>
            <Separator style="-fx-opacity: 0.2;"/>
            <HBox spacing="10" style="-fx-padding: 12 20;">
                <Label text="Time" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
                <Label fx:id="timeLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px;"/>
            </HBox>
            <Separator style="-fx-opacity: 0.2;"/>
            <HBox spacing="10" style="-fx-padding: 12 20;">
                <Label text="Visitors" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
                <Label fx:id="visitorsLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px;"/>
            </HBox>
            <Separator style="-fx-opacity: 0.2;"/>
            <HBox spacing="10" style="-fx-padding: 12 20;">
                <Label text="Confirmation" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
                <Label fx:id="codeLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px;"/>
            </HBox>
            <Separator style="-fx-opacity: 0.2;"/>
            <HBox spacing="10" style="-fx-padding: 12 20;">
                <Label text="Status" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
                <Label fx:id="statusLabel" style="-fx-text-fill: #34d399; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
        <!-- Confirm button -->
        <VBox style="-fx-padding: 16 20 20 20;">
            <Button fx:id="confirmExitBtn" text="Confirm Exit" onAction="#handleConfirmExit" maxWidth="Infinity"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8;
                           -fx-padding: 11 0; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;"/>
        </VBox>
    </VBox>

    <Label fx:id="messageLabel" text="" wrapText="true" maxWidth="420"
           style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>

</VBox>
</ScrollPane>
