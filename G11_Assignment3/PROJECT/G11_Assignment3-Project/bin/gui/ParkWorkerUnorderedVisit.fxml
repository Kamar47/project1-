<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="TOP_CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkWorkerUnorderedVisitController"
      style="-fx-padding: 20;">
    <Label text="Unordered visit system" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
    <HBox spacing="10" alignment="CENTER">
        <Label text="Current allowed walk-in spots:" style="-fx-text-fill: #808098;"/>
        <Label fx:id="availableWalkinLabel" text="--" style="-fx-text-fill: #00e676; -fx-font-size: 16px; -fx-font-weight: bold;"/>
    </HBox>
    <VBox spacing="10" style="-fx-background-color: #16213e; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #0f3460; -fx-border-radius: 10;" maxWidth="450">
        <GridPane hgap="12" vgap="10">
            <Label text="Traveler ID:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="travelerIdField" promptText="Enter ID" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Label text="First name:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="firstNameField" promptText="First name" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Label text="Last name:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="lastNameField" promptText="Last name" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="2"
                       style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Label text="Visitors:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="visitorsField" promptText="Number" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="3"
                       style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Label text="Email:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="emailField" promptText="Email" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="4"
                       style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Label text="Phone:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="phoneField" promptText="Phone number" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="5"
                       style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
            <Label text="Type:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <ComboBox fx:id="typeCombo" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            <Label text="Price:" style="-fx-text-fill: #c0c0d8;" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <Label fx:id="priceLabel" text="--" style="-fx-text-fill: #00e676; -fx-font-size: 16px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        </GridPane>
    </VBox>
    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #e94560;"/>
    <Button text="Process walk-in order" onAction="#handleOrder" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 25; -fx-font-size: 13px;"/>
</VBox>
