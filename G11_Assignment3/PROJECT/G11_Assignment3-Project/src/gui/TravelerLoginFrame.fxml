<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="22" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.TravelerLoginController"
      style="-fx-background-color: #12121f;" prefWidth="500" prefHeight="420">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="Traveler Login" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Enter your ID number to continue" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <VBox spacing="6" maxWidth="320">
        <TextFlow>
            <Text text="ID Number" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
            <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        </TextFlow>
        <TextField fx:id="idField" promptText="Enter your ID number" maxWidth="Infinity"
                   style="-fx-background-color: #1c1c2e; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 11; -fx-font-size: 14px;"/>
    </VBox>

    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #f87171; -fx-font-size: 12px;"/>

    <HBox alignment="CENTER" spacing="15">
        <Button text="Back" onAction="#handleBack"
                style="-fx-background-color: #252538; -fx-text-fill: #c0c0d8; -fx-background-radius: 10; -fx-padding: 10 30; -fx-cursor: hand;"/>
        <Button text="Login" onAction="#handleLogin"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 30; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>