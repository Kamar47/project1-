<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkWorkerUnorderedVisitController" style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="18" style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Unordered Visit System" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>

    <HBox spacing="10" alignment="CENTER" style="-fx-background-color: #1c1c2e; -fx-padding: 12 20; -fx-background-radius: 10;">
        <Label text="Available walk-in spots:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
        <Label fx:id="availableWalkinLabel" text="--" style="-fx-text-fill: #34d399; -fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>

    <VBox spacing="14" maxWidth="400" style="-fx-background-color: #1c1c2e; -fx-padding: 26; -fx-background-radius: 14;">

        <VBox spacing="6">
            <TextFlow>
                <Text text="Traveler ID" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="travelerIdField" promptText="Enter ID number" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="First Name (optional)" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <TextField fx:id="firstNameField" promptText="First name" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Last Name (optional)" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <TextField fx:id="lastNameField" promptText="Last name" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="Visitors" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="visitorsField" promptText="Number of visitors" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="Email" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="emailField" promptText="name@example.com" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Phone (optional)" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <TextField fx:id="phoneField" promptText="050-1234567" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="Type" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <ComboBox fx:id="typeCombo" maxWidth="Infinity"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 6 0 0 0;">
            <Label text="Price:" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
            <Label fx:id="priceLabel" text="--" style="-fx-text-fill: #34d399; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>

    </VBox>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #f87171; -fx-font-size: 12px;"/>
    <Button text="Process Walk-in Order" onAction="#handleOrder"
            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 11 30; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;"/>
</VBox>
</ScrollPane>