<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="server.ServerController">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
    <Label text="GoNature Server" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Separator/>
    <GridPane hgap="10" vgap="5">
        <Label text="Port:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="portField" text="5555" prefWidth="80" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="DB URL:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="dbUrlField" text="jdbc:mysql://localhost/gonature?serverTimezone=UTC" prefWidth="350" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="DB User:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="dbUserField" text="root" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="DB Password:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <PasswordField fx:id="dbPassField" promptText="Enter DB password" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>
    <HBox spacing="10"><Button fx:id="startButton" text="Start Server" onAction="#handleStart"/>
        <Button fx:id="stopButton" text="Stop Server" onAction="#handleStop" disable="true"/></HBox>
    <Separator/>
    <Label text="Connected Clients" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <TableView fx:id="clientTable" prefHeight="120">
        <placeholder><Label text="No clients connected"/></placeholder>
        <columns>
            <TableColumn fx:id="colIp" text="IP Address" prefWidth="150"/>
            <TableColumn fx:id="colHost" text="Host Name" prefWidth="180"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
        </columns>
    </TableView>
    <Separator/>
    <Label text="Server Log" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <TextArea fx:id="logArea" editable="false" prefRowCount="8" style="-fx-font-family: monospace;"/>
</VBox>
