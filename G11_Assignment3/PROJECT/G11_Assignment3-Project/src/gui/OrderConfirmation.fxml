<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.OrderConfirmationController" style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 30; -fx-background-color: #12121f;">

    <!-- Check icons -->
    <HBox alignment="CENTER" spacing="0">
        <Label text="✓" style="-fx-font-size: 34px; -fx-text-fill: #12121f; -fx-background-color: #34d399; -fx-background-radius: 50; -fx-min-width: 60; -fx-min-height: 60; -fx-alignment: center;"/>
        <Region prefWidth="40" style="-fx-background-color: #34d399; -fx-max-height: 3; -fx-min-height: 3;"/>
        <Label text="✓" style="-fx-font-size: 34px; -fx-text-fill: #12121f; -fx-background-color: #34d399; -fx-background-radius: 50; -fx-min-width: 60; -fx-min-height: 60; -fx-alignment: center;"/>
    </HBox>

    <Label text="Thank you for your order" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f1f5f9; -fx-padding: 8 0 0 0;"/>
    <Label text="Confirmation message has been sent to your phone and email" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" wrapText="true" textAlignment="CENTER"/>
    <Label text="We will not charge you until you arrive at the park" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" wrapText="true" textAlignment="CENTER"/>

    <!-- Visit info card -->
    <VBox spacing="14" maxWidth="380" style="-fx-background-color: #1c1c2e; -fx-padding: 24; -fx-background-radius: 14;">
        <Label text="Visit Information" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10"><Label text="Date" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="dateLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/></HBox>
        <HBox spacing="10"><Label text="Time" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="timeLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/></HBox>
        <HBox spacing="10"><Label text="Park" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="parkLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/></HBox>
        <HBox spacing="10"><Label text="Type" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="typeLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/></HBox>
        <HBox spacing="10"><Label text="Visitors" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="visitorsLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/></HBox>
        <HBox spacing="10"><Label text="Order Status" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="statusLabel" style="-fx-text-fill: #fbbf24; -fx-font-size: 14px; -fx-font-weight: bold;"/></HBox>
        <HBox spacing="10"><Label text="Confirmation Code" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="confirmationCodeLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px; -fx-font-weight: bold;"/></HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10"><Label text="Total Price" style="-fx-text-fill: #34d399; -fx-min-width: 110; -fx-font-size: 13px;"/><Label fx:id="priceLabel" style="-fx-text-fill: #34d399; -fx-font-size: 16px; -fx-font-weight: bold;"/></HBox>
    </VBox>

    <Label text="Your order number is" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px; -fx-padding: 6 0 0 0;"/>
    <Label fx:id="orderNumberLabel" text="--" style="-fx-text-fill: #34d399; -fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="We'll send you a reminder!" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px; -fx-font-weight: bold;"/>

    <Button text="Home" onAction="#handleHome" style="-fx-background-color: transparent; -fx-text-fill: #34d399; -fx-border-color: #34d399; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 10 40; -fx-cursor: hand; -fx-font-size: 13px;"/>
</VBox>
</ScrollPane>
