<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkManagerParametersController" style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Park Parameters" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label fx:id="parkNameLabel" text="" style="-fx-font-size: 15px; -fx-text-fill: #f1f5f9;"/>
    <Label text="Enter a new value only for the parameters you want to change" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
    <Label fx:id="statusLabel" text=""/>

    <GridPane hgap="20" vgap="18" alignment="CENTER" style="-fx-background-color: #1c1c2e; -fx-padding: 25; -fx-background-radius: 12;">
        <Label text="Parameter" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #34d399; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label text="Current Value" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-text-fill: #34d399; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label text="New Value" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-text-fill: #34d399; -fx-font-weight: bold; -fx-font-size: 14px;"/>

        <Label text="Max Visitors:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px;"/>
        <Label fx:id="currentMaxVisitors" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #fbbf24; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        <TextField fx:id="newMaxVisitors" promptText="Enter new value" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

        <Label text="Walk-in Gap:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px;"/>
        <Label fx:id="currentGap" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #fbbf24; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        <TextField fx:id="newGap" promptText="Enter new value" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

        <Label text="Stay Time (hours):" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-text-fill: #f1f5f9; -fx-font-size: 13px;"/>
        <Label fx:id="currentStayTime" text="--" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-text-fill: #fbbf24; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        <TextField fx:id="newStayTime" promptText="Enter new value" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
    </GridPane>

    <Button text="Submit Change Request" onAction="#handleSubmit"
            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 30; -fx-font-size: 13px; -fx-font-weight: bold;"/>

    <Label text="My Pending Requests" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="requestsTable" prefHeight="180" maxWidth="700">
        <columns>
            <TableColumn fx:id="colParam" text="Parameter" prefWidth="160"/>
            <TableColumn fx:id="colOld" text="Current" prefWidth="100"/>
            <TableColumn fx:id="colNew" text="Requested" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
</ScrollPane>