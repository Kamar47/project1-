<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="TOP_CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkManagerCreateReportController" style="-fx-padding: 20;">
    <Label text="Create report" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
    <HBox spacing="15" alignment="CENTER">
        <VBox spacing="8">
            <Label text="Report type:" style="-fx-text-fill: #c0c0d8;"/>
            <ComboBox fx:id="reportTypeCombo" prefWidth="200"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Month:" style="-fx-text-fill: #c0c0d8;"/>
            <ComboBox fx:id="monthCombo" prefWidth="100"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Year:" style="-fx-text-fill: #c0c0d8;"/>
            <ComboBox fx:id="yearCombo" prefWidth="100"/>
        </VBox>
    </HBox>
    <Button text="Generate report" onAction="#handleGenerate" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 25;"/>
    <Label fx:id="statusLabel" text=""/>
    <VBox fx:id="reportArea" spacing="10" visible="false" managed="false"
          style="-fx-background-color: #16213e; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #0f3460; -fx-border-radius: 10;" maxWidth="600">
        <Label fx:id="reportTitleLabel" text="" style="-fx-text-fill: #2d6a4f; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        <TextArea fx:id="reportContent" prefRowCount="12" editable="false"
                  style="-fx-control-inner-background: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-font-family: monospace; -fx-font-size: 12px;"/>
        <TextField fx:id="commentField" promptText="Add comments to the report"
                   style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <HBox spacing="10" alignment="CENTER">
            <Button text="Save report" onAction="#handleSave" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8;"/>
            <Button text="Close" onAction="#handleClose" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 8;"/>
        </HBox>
    </VBox>
</VBox>
