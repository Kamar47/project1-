<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox alignment="TOP_CENTER" spacing="18" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkWorkerCheckSpaceController"
      style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Check Available Space" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Live capacity status for your park" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <VBox spacing="14" maxWidth="420" style="-fx-background-color: #1c1c2e; -fx-padding: 26; -fx-background-radius: 14;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Park Name" style="-fx-text-fill: #94a3b8; -fx-min-width: 140; -fx-font-size: 13px;"/>
            <Label fx:id="parkNameLabel" text="--" style="-fx-text-fill: #f1f5f9; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Max Capacity" style="-fx-text-fill: #94a3b8; -fx-min-width: 140; -fx-font-size: 13px;"/>
            <Label fx:id="maxVisitorsLabel" text="--" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Current Visitors" style="-fx-text-fill: #94a3b8; -fx-min-width: 140; -fx-font-size: 13px;"/>
            <Label fx:id="currentVisitorsLabel" text="--" style="-fx-text-fill: #fbbf24; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Available Spots" style="-fx-text-fill: #94a3b8; -fx-min-width: 140; -fx-font-size: 13px;"/>
            <Label fx:id="availableSpotsLabel" text="--" style="-fx-text-fill: #34d399; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Walk-in Gap" style="-fx-text-fill: #94a3b8; -fx-min-width: 140; -fx-font-size: 13px;"/>
            <Label fx:id="gapLabel" text="--" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Status" style="-fx-text-fill: #94a3b8; -fx-min-width: 140; -fx-font-size: 13px;"/>
            <Label fx:id="statusLabel" text="--" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>
    </VBox>

    <Button text="Refresh" onAction="#loadParkInfo"
            style="-fx-background-color: #252538; -fx-text-fill: #34d399; -fx-border-color: #34d399; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 28; -fx-cursor: hand;"/>
</VBox>