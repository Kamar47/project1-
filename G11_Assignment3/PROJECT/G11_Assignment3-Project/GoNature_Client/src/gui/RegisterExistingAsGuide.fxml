<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<VBox alignment="TOP_CENTER" spacing="18" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.RegisterExistingAsGuideController" style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Register Existing Traveler as Guide" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Promote an existing subscriber to a tour guide" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <VBox spacing="14" maxWidth="380" style="-fx-background-color: #1c1c2e; -fx-padding: 26; -fx-background-radius: 14;">
        <VBox spacing="6">
            <TextFlow>
                <Text text="Traveler ID" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="idField" promptText="Enter traveler's ID number" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <Button text="Submit" onAction="#handleSubmit" maxWidth="Infinity"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 11 0; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </VBox>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px;"/>
</VBox>