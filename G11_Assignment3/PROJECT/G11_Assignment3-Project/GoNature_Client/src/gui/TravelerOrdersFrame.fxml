<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="TOP_CENTER" spacing="18" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.TravelerOrdersController"
      style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="My Orders" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="View and manage your park visit bookings." style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <TableView fx:id="ordersTable" prefHeight="320" maxWidth="820">
        <columns>
            <TableColumn fx:id="colId" text="Order ID" prefWidth="70"/>
            <TableColumn fx:id="colPark" text="Park" prefWidth="130"/>
            <TableColumn fx:id="colVisitors" text="Visitors" prefWidth="70"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colTime" text="Time" prefWidth="75"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
            <TableColumn fx:id="colPrice" text="Price" prefWidth="80"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #f87171; -fx-font-size: 12px;"/>

    <HBox alignment="CENTER" spacing="12">
        <Button text="Cancel Order" onAction="#handleCancel"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 26; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="confirmBtn" text="Confirm Order" onAction="#handleConfirm"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 26; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="Refresh" onAction="#loadOrders"
                style="-fx-background-color: #252538; -fx-text-fill: #34d399; -fx-border-color: #34d399; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 26; -fx-cursor: hand;"/>
    </HBox>
</VBox>