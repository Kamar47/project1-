<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="TOP_CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.RegisterExistingAsGuideController" style="-fx-padding: 20;">
    <Label text="Register existing traveler as guide" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
    <HBox spacing="10" alignment="CENTER">
        <Label text="Traveler ID:" style="-fx-text-fill: #c0c0d8;"/>
        <TextField fx:id="idField" prefWidth="200" style="-fx-background-color: #16213e; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <Button text="Submit" onAction="#handleSubmit" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8;"/>
    </HBox>
    <Label fx:id="statusLabel" text=""/>
</VBox>
