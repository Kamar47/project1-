<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane fx:id="mainBorderPane" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ServiceWorkerFrameController"
            style="-fx-background-color: #12121f;" prefWidth="900" prefHeight="650">
    <left>
        <VBox spacing="8" style="-fx-background-color: #1c1c2e; -fx-padding: 18 14; -fx-min-width: 180;" alignment="TOP_CENTER">
            <Label text="GoNature" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #34d399; -fx-padding: 12 0 6 0;"/>
            <Label fx:id="workerNameLabel" text="Service Worker" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-padding: 0 0 18 0;"/>
            <Button text="Profile" onAction="#showProfile" prefWidth="150"
                    style="-fx-background-color: #252538; -fx-text-fill: #e2e8f0; -fx-background-radius: 10; -fx-padding: 11 0; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button text="Register New Guide" onAction="#showRegisterGuide" prefWidth="150" wrapText="true"
                    style="-fx-background-color: #252538; -fx-text-fill: #e2e8f0; -fx-background-radius: 10; -fx-padding: 11 0; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button text="Register Subscriber" onAction="#showRegisterSubscriber" prefWidth="150" wrapText="true"
                    style="-fx-background-color: #252538; -fx-text-fill: #e2e8f0; -fx-background-radius: 10; -fx-padding: 11 0; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <Button text="Register Existing As Guide" onAction="#showRegisterExisting" prefWidth="150" wrapText="true"
                    style="-fx-background-color: #252538; -fx-text-fill: #e2e8f0; -fx-background-radius: 10; -fx-padding: 11 0; -fx-cursor: hand; -fx-font-size: 13px;"/>
            <VBox VBox.vgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout" prefWidth="150"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 11 0; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;"/>
        </VBox>
    </left>
    <center>
        <VBox fx:id="contentArea" alignment="CENTER" spacing="12" style="-fx-padding: 30; -fx-background-color: #12121f;">
            <Label text="Service Worker" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
            <Label text="Select an option from the menu to get started" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
        </VBox>
    </center>
</BorderPane>