<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="TOP_CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkManagerParametersController" style="-fx-padding: 20;">
    <Label text="Park parameters" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
    <VBox spacing="10" style="-fx-background-color: #16213e; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #0f3460; -fx-border-radius: 10;" maxWidth="500">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Park name:" style="-fx-text-fill: #808098; -fx-min-width: 160;"/>
            <Label fx:id="parkNameLabel" text="--" style="-fx-text-fill: #e0e0f0; -fx-font-weight: bold;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Current visitors:" style="-fx-text-fill: #808098; -fx-min-width: 160;"/>
            <Label fx:id="currentVisitorsLabel" text="--" style="-fx-text-fill: #f5a623; -fx-font-weight: bold;"/>
        </HBox>
        <Separator/>
        <Label text="Request parameter change (requires department manager approval)" style="-fx-text-fill: #a0a0b8; -fx-font-size: 11px;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Max visitors:" style="-fx-text-fill: #c0c0d8; -fx-min-width: 160;"/>
            <TextField fx:id="maxVisitorsField" prefWidth="100" style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Walk-in gap:" style="-fx-text-fill: #c0c0d8; -fx-min-width: 160;"/>
            <TextField fx:id="gapField" prefWidth="100" style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Estimated visit (hours):" style="-fx-text-fill: #c0c0d8; -fx-min-width: 160;"/>
            <TextField fx:id="durationField" prefWidth="100" style="-fx-background-color: #0d1b2a; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        </HBox>
    </VBox>
    <Label fx:id="statusLabel" text=""/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Refresh" onAction="#loadParkInfo" style="-fx-background-color: #0f3460; -fx-text-fill: #c0c0d8; -fx-background-radius: 8; -fx-padding: 8 20;"/>
        <Button text="Submit change request" onAction="#handleSubmitChange" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20;"/>
    </HBox>
</VBox>
