<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkWorkerEntranceControlController" style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="18" style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Entrance Control" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>

    <!-- Search -->
    <VBox spacing="12" maxWidth="420" style="-fx-background-color: #1c1c2e; -fx-padding: 22; -fx-background-radius: 14;">
        <VBox spacing="6">
            <TextFlow>
                <Text text="Visitor ID / Confirmation Code" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="visitorIdField" promptText="Enter ID or confirmation code" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>
        <Button text="Check" onAction="#handleCheck" maxWidth="Infinity"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 0; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </VBox>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #f87171; -fx-font-size: 12px;"/>

    <!-- Booking details (read-only output) -->
    <VBox fx:id="orderInfoBox" spacing="12" visible="false" managed="false" maxWidth="450"
          style="-fx-background-color: #1c1c2e; -fx-padding: 20; -fx-background-radius: 14;">
        <Label text="Booking Details" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        <HBox spacing="10"><Label text="Order ID" style="-fx-text-fill: #94a3b8; -fx-min-width: 120;"/><Label fx:id="orderIdLabel" style="-fx-text-fill: #f1f5f9;"/></HBox>
        <HBox spacing="10"><Label text="Park" style="-fx-text-fill: #94a3b8; -fx-min-width: 120;"/><Label fx:id="parkLabel" style="-fx-text-fill: #f1f5f9;"/></HBox>
        <HBox spacing="10"><Label text="Visit Date" style="-fx-text-fill: #94a3b8; -fx-min-width: 120;"/><Label fx:id="dateLabel" style="-fx-text-fill: #f1f5f9;"/></HBox>
        <HBox spacing="10"><Label text="Time" style="-fx-text-fill: #94a3b8; -fx-min-width: 120;"/><Label fx:id="timeLabel" style="-fx-text-fill: #f1f5f9;"/></HBox>
        <HBox spacing="10"><Label text="Visitors" style="-fx-text-fill: #94a3b8; -fx-min-width: 120;"/><Label fx:id="visitorsLabel" style="-fx-text-fill: #f1f5f9;"/></HBox>
        <HBox spacing="10"><Label text="Type" style="-fx-text-fill: #94a3b8; -fx-min-width: 120;"/><Label fx:id="typeLabel" style="-fx-text-fill: #f1f5f9;"/></HBox>
        <HBox spacing="10"><Label text="Price" style="-fx-text-fill: #94a3b8; -fx-min-width: 120;"/><Label fx:id="priceLabel" style="-fx-text-fill: #34d399; -fx-font-size: 16px; -fx-font-weight: bold;"/></HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="12" alignment="CENTER">
            <Button text="Approve Entry" onAction="#handleApproveEntry"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 9 25; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Deny Entry" onAction="#handleDeny"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 9 25; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <Separator style="-fx-opacity: 0.3;"/>

    <!-- Process exit -->
    <Label text="Process Exit" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <VBox spacing="12" maxWidth="420" style="-fx-background-color: #1c1c2e; -fx-padding: 22; -fx-background-radius: 14;">
        <VBox spacing="6">
            <TextFlow>
                <Text text="Visitor ID" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="exitIdField" promptText="Enter ID" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>
        <VBox spacing="6">
            <TextFlow>
                <Text text="Visitors Leaving" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="exitCountField" promptText="Number leaving" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>
        <Button text="Process Exit" onAction="#handleExit" maxWidth="Infinity"
                style="-fx-background-color: #252538; -fx-text-fill: #34d399; -fx-border-color: #34d399; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 0; -fx-cursor: hand;"/>
    </VBox>
    <Label fx:id="exitStatusLabel" text="" style="-fx-text-fill: #34d399; -fx-font-size: 12px;"/>
</VBox>
</ScrollPane>