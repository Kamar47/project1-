<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.HomePageController"
      style="-fx-background-color: #12121f;" prefWidth="800" prefHeight="650">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    <Label text="Welcome to GoNature" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Discover the beauty of our parks and streamline your visit" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" wrapText="true" textAlignment="CENTER"/>

    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10; -fx-background-color: #1c1c2e; -fx-background-radius: 12;">
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 16;">
            <Label text="Server" style="-fx-text-fill: #94a3b8;"/>
            <TextField fx:id="serverHostField" text="localhost" prefWidth="150"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-border-color: #34344f; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>
            <Label text="Port" style="-fx-text-fill: #94a3b8;"/>
            <TextField fx:id="serverPortField" text="5555" prefWidth="70"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-border-color: #34344f; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;"/>
            <Button fx:id="connectBtn" text="Connect" onAction="#handleConnect"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
        <Label fx:id="connectionStatus" text="" style="-fx-text-fill: #f87171;"/>
    </VBox>

    <VBox alignment="CENTER" spacing="12" style="-fx-padding: 10;">
        <Button fx:id="travelerLoginBtn" text="Traveler Login" onAction="#handleTravelerLogin" disable="true"
                prefWidth="220" prefHeight="44" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;"/>
        <Button fx:id="workerLoginBtn" text="Worker Login" onAction="#handleWorkerLogin" disable="true"
                prefWidth="220" prefHeight="44" style="-fx-background-color: #252538; -fx-text-fill: #e2e8f0; -fx-font-size: 15px; -fx-background-radius: 10; -fx-border-color: #34344f; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-cursor: hand;"/>
    </VBox>

    <Label text="Our Parks" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: bold;"/>
    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 0 20 5 20;">
        <VBox alignment="CENTER" spacing="6" style="-fx-background-color: #1c1c2e; -fx-padding: 12; -fx-background-radius: 12; -fx-border-color: #34d399; -fx-border-radius: 12; -fx-min-width: 180;">
            <ImageView fitWidth="160" fitHeight="100" preserveRatio="true">
                <Image url="@/images/banias.jpg"/>
            </ImageView>
            <Label text="Banias" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="Nature Reserve" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="6" style="-fx-background-color: #1c1c2e; -fx-padding: 12; -fx-background-radius: 12; -fx-border-color: #34d399; -fx-border-radius: 12; -fx-min-width: 180;">
            <ImageView fitWidth="160" fitHeight="100" preserveRatio="true">
                <Image url="@/images/eingedi.jpg"/>
            </ImageView>
            <Label text="Ein Gedi" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="Nature Reserve" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
        <VBox alignment="CENTER" spacing="6" style="-fx-background-color: #1c1c2e; -fx-padding: 12; -fx-background-radius: 12; -fx-border-color: #34d399; -fx-border-radius: 12; -fx-min-width: 180;">
            <ImageView fitWidth="160" fitHeight="100" preserveRatio="true">
                <Image url="@/images/masada.jpg"/>
            </ImageView>
            <Label text="Masada" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="National Park" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
        </VBox>
    </HBox>

    <Button text="Exit" onAction="#handleExit"
            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 25; -fx-cursor: hand;"/>
</VBox>