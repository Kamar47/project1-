<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="TOP_CENTER" spacing="18" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ProfileController"
      style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Profile" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Your account information" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <VBox spacing="16" maxWidth="420" style="-fx-background-color: #1c1c2e; -fx-padding: 28; -fx-background-radius: 14;">
        <HBox spacing="10">
            <Label text="Name" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
            <Label fx:id="nameLabel" style="-fx-text-fill: #f1f5f9; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10">
            <Label text="ID" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
            <Label fx:id="idLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10">
            <Label text="Email" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
            <Label fx:id="emailLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10">
            <Label text="Role" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
            <Label fx:id="roleLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/>
        </HBox>
        <Separator style="-fx-opacity: 0.3;"/>
        <HBox spacing="10">
            <Label text="Subscriber / Park" style="-fx-text-fill: #94a3b8; -fx-min-width: 130; -fx-font-size: 13px;"/>
            <Label fx:id="subscriberLabel" style="-fx-text-fill: #f1f5f9; -fx-font-size: 14px;"/>
        </HBox>
    </VBox>
</VBox>