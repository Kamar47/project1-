<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="TOP_CENTER" spacing="15" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkWorkerEntranceControlController"
      style="-fx-padding: 20;">
    <Label text="Entrance control" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
    <HBox spacing="10" alignment="CENTER">
        <Label text="Visitor ID / Confirmation code:" style="-fx-text-fill: #c0c0d8;"/>
        <TextField fx:id="visitorIdField" promptText="Enter ID or code" prefWidth="200"
                   style="-fx-background-color: #16213e; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <Button text="Check" onAction="#handleCheck" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8;"/>
    </HBox>
    <Label fx:id="statusLabel" text="" style="-fx-text-fill: #e94560;"/>
    <VBox fx:id="orderInfoBox" spacing="8" visible="false" managed="false"
          style="-fx-background-color: #16213e; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #0f3460; -fx-border-radius: 10;" maxWidth="450">
        <Label text="Booking details" style="-fx-text-fill: #2d6a4f; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        <HBox spacing="10"><Label text="Order ID:" style="-fx-text-fill: #808098; -fx-min-width: 120;"/><Label fx:id="orderIdLabel" style="-fx-text-fill: #e0e0f0;"/></HBox>
        <HBox spacing="10"><Label text="Park:" style="-fx-text-fill: #808098; -fx-min-width: 120;"/><Label fx:id="parkLabel" style="-fx-text-fill: #e0e0f0;"/></HBox>
        <HBox spacing="10"><Label text="Visit date:" style="-fx-text-fill: #808098; -fx-min-width: 120;"/><Label fx:id="dateLabel" style="-fx-text-fill: #e0e0f0;"/></HBox>
        <HBox spacing="10"><Label text="Time:" style="-fx-text-fill: #808098; -fx-min-width: 120;"/><Label fx:id="timeLabel" style="-fx-text-fill: #e0e0f0;"/></HBox>
        <HBox spacing="10"><Label text="Visitors:" style="-fx-text-fill: #808098; -fx-min-width: 120;"/><Label fx:id="visitorsLabel" style="-fx-text-fill: #e0e0f0;"/></HBox>
        <HBox spacing="10"><Label text="Type:" style="-fx-text-fill: #808098; -fx-min-width: 120;"/><Label fx:id="typeLabel" style="-fx-text-fill: #e0e0f0;"/></HBox>
        <HBox spacing="10"><Label text="Price:" style="-fx-text-fill: #808098; -fx-min-width: 120;"/><Label fx:id="priceLabel" style="-fx-text-fill: #00e676; -fx-font-size: 16px;"/></HBox>
        <Separator/>
        <HBox spacing="10" alignment="CENTER">
            <Button text="Approve entry" onAction="#handleApproveEntry" style="-fx-background-color: #2d6a4f; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 25;"/>
            <Button text="Deny entry" onAction="#handleDeny" style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 25;"/>
        </HBox>
    </VBox>
    <Separator/>
    <Label text="Process exit" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d6a4f;"/>
    <HBox spacing="10" alignment="CENTER">
        <Label text="Visitor ID:" style="-fx-text-fill: #c0c0d8;"/>
        <TextField fx:id="exitIdField" promptText="Enter ID" prefWidth="150"
                   style="-fx-background-color: #16213e; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <Label text="Visitors leaving:" style="-fx-text-fill: #c0c0d8;"/>
        <TextField fx:id="exitCountField" promptText="Count" prefWidth="60"
                   style="-fx-background-color: #16213e; -fx-text-fill: #e0e0f0; -fx-border-color: #0f3460; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        <Button text="Process exit" onAction="#handleExit" style="-fx-background-color: #0f3460; -fx-text-fill: #c0c0d8; -fx-background-radius: 8;"/>
    </HBox>
    <Label fx:id="exitStatusLabel" text="" style="-fx-text-fill: #00e676;"/>
</VBox>
