<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.LookupUserController"
            style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30; -fx-background-color: #12121f;">

    <Label text="Lookup User"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Search by subscriber ID or employee number"
           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <!-- Search box -->
    <VBox spacing="8" maxWidth="480"
          style="-fx-background-color: #1c1c2e; -fx-padding: 22; -fx-background-radius: 14;">
        <Label text="Subscriber: enter ID number  |  Employee: enter employee number"
               style="-fx-text-fill: #64748b; -fx-font-size: 11px;" wrapText="true"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="lookupIdField" promptText="Enter ID / Employee number" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b;
                              -fx-border-color: #34344f; -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-border-width: 1.5; -fx-padding: 10;"/>
            <Button text="Search" onAction="#handleLookup"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8;
                           -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Result card -->
    <VBox fx:id="resultCard" maxWidth="480" spacing="0"
          style="-fx-background-color: #1c1c2e; -fx-background-radius: 14; -fx-border-color: #34344f;
                 -fx-border-radius: 14; -fx-border-width: 1;"
          visible="false" managed="false">
        <!-- Header -->
        <HBox style="-fx-background-color: #252538; -fx-padding: 14 20; -fx-background-radius: 14 14 0 0;">
            <Label fx:id="cardTypeLabel" text=""/>
        </HBox>
        <!-- Rows injected by controller -->
        <VBox fx:id="cardRows" spacing="0"/>
    </VBox>

    <!-- Error label -->
    <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="480"
           style="-fx-text-fill: #f87171; -fx-font-size: 13px;" visible="false" managed="false"/>

</VBox>
</ScrollPane>
