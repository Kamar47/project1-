<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.ParkManagerCreateReportController" style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="18" style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Create Report" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Generate and save reports for your park" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <HBox spacing="15" alignment="CENTER" style="-fx-background-color: #1c1c2e; -fx-padding: 22; -fx-background-radius: 14;">
        <VBox spacing="6">
            <Label text="Report Type" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <ComboBox fx:id="reportTypeCombo" prefWidth="200"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Month" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <ComboBox fx:id="monthCombo" prefWidth="80"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Year" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <ComboBox fx:id="yearCombo" prefWidth="80"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Generate Report" onAction="#handleGenerate"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 28; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="View Saved Reports" onAction="#handleViewSaved"
                style="-fx-background-color: #252538; -fx-text-fill: #34d399; -fx-border-color: #34d399; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10 28; -fx-font-size: 13px; -fx-cursor: hand;"/>
    </HBox>
    <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px;"/>

    <VBox fx:id="savedReportsBox" visible="false" managed="false" spacing="10" alignment="CENTER">
        <Label text="Saved Reports (double-click to open)" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        <TableView fx:id="savedReportsTable" prefHeight="250" maxWidth="750">
            <columns>
                <TableColumn fx:id="colId" text="#" prefWidth="40"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="140"/>
                <TableColumn fx:id="colMonth" text="Month" prefWidth="80"/>
                <TableColumn fx:id="colYear" text="Year" prefWidth="70"/>
                <TableColumn fx:id="colCreated" text="Created" prefWidth="170"/>
                <TableColumn fx:id="colHasComment" text="Comment" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
</ScrollPane>