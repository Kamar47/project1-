<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.RegisterSubscriberController" style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="18" style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Register Subscriber" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Family club membership registration" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <VBox spacing="14" maxWidth="380" style="-fx-background-color: #1c1c2e; -fx-padding: 26; -fx-background-radius: 14;">

        <VBox spacing="6">
            <TextFlow>
                <Text text="ID Number" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="idField" promptText="9-digit ID" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="First Name" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="firstNameField" promptText="First name" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="Last Name" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="lastNameField" promptText="Last name" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="Phone" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="phoneField" promptText="050-1234567" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="Email" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="emailField" promptText="name@example.com" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <TextFlow>
                <Text text="Family Members" style="-fx-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Text text=" *" style="-fx-fill: #f87171; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </TextFlow>
            <TextField fx:id="familyField" promptText="Number of members" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Credit Card (optional)" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <TextField fx:id="creditCardField" promptText="Card number" maxWidth="Infinity"
                       style="-fx-background-color: #252538; -fx-text-fill: #f1f5f9; -fx-prompt-text-fill: #64748b; -fx-border-color: #34344f; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1.5; -fx-padding: 10;"/>
        </VBox>

    </VBox>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px;"/>
    <Button text="Register" onAction="#handleRegister"
            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 11 40; -fx-font-weight: bold; -fx-cursor: hand;"/>
</VBox>
</ScrollPane>