<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml" fx:controller="gui.DeptManagerRequestsController" style="-fx-background: #12121f; -fx-background-color: #12121f;">
<VBox alignment="TOP_CENTER" spacing="16" style="-fx-padding: 25; -fx-background-color: #12121f;">
    <Label text="Pending Requests" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #34d399;"/>
    <Label text="Review and approve changes submitted by park managers" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>

    <Label text="Parameter Change Requests" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="paramRequestsTable" prefHeight="180" maxWidth="780">
        <placeholder><Label text="No pending parameter requests" style="-fx-text-fill: #64748b;"/></placeholder>
        <columns>
            <TableColumn fx:id="colParamId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colParamPark" text="Park" prefWidth="90"/>
            <TableColumn fx:id="colParamName" text="Parameter" prefWidth="150"/>
            <TableColumn fx:id="colOldVal" text="Old Value" prefWidth="90"/>
            <TableColumn fx:id="colNewVal" text="New Value" prefWidth="90"/>
            <TableColumn fx:id="colParamStatus" text="Status" prefWidth="90"/>
        </columns>
    </TableView>
    <HBox spacing="12" alignment="CENTER">
        <Button text="Approve" onAction="#handleApproveParam"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 9 25; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="Reject" onAction="#handleRejectParam"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 9 25; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="Refresh" onAction="#loadRequests"
                style="-fx-background-color: #252538; -fx-text-fill: #34d399; -fx-border-color: #34d399; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 9 25; -fx-cursor: hand;"/>
    </HBox>

    <Separator style="-fx-opacity: 0.3;"/>

    <Label text="Promotion Requests" style="-fx-text-fill: #34d399; -fx-font-size: 15px; -fx-font-weight: bold;"/>
    <TableView fx:id="promoRequestsTable" prefHeight="160" maxWidth="780">
        <placeholder><Label text="No pending promotion requests" style="-fx-text-fill: #64748b;"/></placeholder>
        <columns>
            <TableColumn fx:id="colPromoId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colPromoPark" text="Park" prefWidth="90"/>
            <TableColumn fx:id="colDiscount" text="Discount %" prefWidth="90"/>
            <TableColumn fx:id="colStart" text="Start" prefWidth="95"/>
            <TableColumn fx:id="colEnd" text="End" prefWidth="95"/>
            <TableColumn fx:id="colDesc" text="Description" prefWidth="130"/>
            <TableColumn fx:id="colPromoStatus" text="Status" prefWidth="80"/>
        </columns>
    </TableView>
    <HBox spacing="12" alignment="CENTER">
        <Button text="Approve" onAction="#handleApprovePromo"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 9 25; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button text="Reject" onAction="#handleRejectPromo"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 9 25; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 12px;"/>
</VBox>
</ScrollPane>